{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Concept Deck Document",
  "description": "Stage 2 of the Velvet Oat pipeline: the creative director's concept deck. Three campaign routes answering the stage-1 brief, with a recommended route. The full hop-1 creative brief is carried, untouched, under 'brief' per the metamorphosis contract.",
  "type": "object",
  "additionalProperties": true,
  "required": ["concepts", "recommended_concept"],
  "properties": {
    "document_stage": {
      "const": "concept-deck",
      "description": "Pipeline stage marker.",
      "type": "string"
    },
    "brief": {
      "type": "object",
      "description": "The complete stage-1 creative brief, carried verbatim from hop 1 (account planner). Must not be dropped.",
      "additionalProperties": true
    },
    "concepts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["concept_name", "big_idea", "key_visual_description", "sample_headlines", "channel_plan", "why_it_answers_the_brief"],
        "properties": {
          "concept_name": { "type": "string" },
          "big_idea": { "type": "string", "description": "The organising creative idea, 2-3 sentences." },
          "tagline_en": { "type": "string" },
          "tagline_ga": { "type": "string", "description": "Irish-language tagline variant (mandatory for TG4 / Gaeltacht OOH)." },
          "tone": { "type": "string" },
          "key_visual_description": { "type": "string" },
          "hero_execution": { "type": "string", "description": "The 30s hero online video idea." },
          "sample_headlines": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "string" }
          },
          "channel_plan": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "ooh": { "type": "string" },
              "social": { "type": "string" },
              "cafe_sampling": { "type": "string" }
            }
          },
          "risk_watch_out": { "type": "string" },
          "why_it_answers_the_brief": { "type": "string" }
        }
      }
    },
    "recommended_concept": {
      "type": "string",
      "description": "concept_name of the recommended route."
    },
    "recommendation_rationale": { "type": "string" }
  }
}
